---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import About from "../components/sections/About.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Blog">
	<ul class="mt-10 space-y-8">
		{
			posts.map((post) => (
				<li data-reeyai-content={JSON.stringify({ collection: "blog", slug: post.id })}>
					<a
						href={`/blog/${post.id}`}
						class="text-xl font-semibold hover:underline"
						data-reeyai-field="title"
					>
						{post.data.title}
					</a>
					<p class="mt-1 text-sm text-zinc-500">
						{post.data.pubDate.toISOString().slice(0, 10)}
						{post.data.tags.length > 0 && <> · {post.data.tags.join(", ")}</>}
					</p>
					<p class="mt-1 text-zinc-300" data-reeyai-field="description">{post.data.description}</p>
				</li>
			))
		}
		</ul>

	<About />
</Base>
