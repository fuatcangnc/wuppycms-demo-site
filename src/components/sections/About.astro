---
interface Props {
	title?: string;
	description?: string;
	highlights?: { label: string; value: string }[];
}

const {
	title = "Hakkımızda",
	description = "Biz, fikirleri hızlıca ürüne dönüştüren küçük ve odaklı bir ekibiz. Astro ve modern web araçlarıyla sade, hızlı ve erişilebilir deneyimler kuruyoruz.",
	highlights = [
		{ label: "Proje", value: "120+" },
		{ label: "Deneyim", value: "8 yıl" },
		{ label: "Ekip", value: "6 kişi" },
	],
} = Astro.props;
---

<section class="mt-section" data-reeyai-section="hakkimizda">
	<p class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Hakkımızda</p>
	<h2 class="mt-3 text-3xl font-semibold tracking-tight" data-reeyai-field="title">{title}</h2>
	<p class="mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground" data-reeyai-field="description">{description}</p>
	<dl class="mt-block grid gap-4 sm:grid-cols-3">
		{
			highlights.map((item) => (
				<div class="rounded-xl border border-border bg-card p-5">
					<dt class="text-xs uppercase tracking-wide text-muted-foreground">{item.label}</dt>
					<dd class="mt-2 text-2xl font-semibold tracking-tight">{item.value}</dd>
				</div>
			))
		}
	</dl>
</section>
