---
// WuppyCMS önizleme köprüsü (ADR 0008).
//
// Bu betik yalnızca sayfa bir üst pencereye gömülüyken ve üst pencere
// `reeyai:hello` gönderdiğinde etkinleşir. Normal ziyaretçi için hiçbir şey
// yapmaz: dinleyici yok, görünür katman yok, veri gönderimi yok.
//
// Protokol (postMessage):
//   parent → site : reeyai:hello | reeyai:pick-mode {on} | reeyai:unpick {path,label}
//                   reeyai:place {path,label,position,scroll} | reeyai:skeleton {path,label,position}
//                   reeyai:skeleton-clear | reeyai:reload | reeyai:back | reeyai:forward
//   site → parent : reeyai:ready | reeyai:pick {selection} | reeyai:page {path,title}
//                   reeyai:navigate {href}
---

<script is:inline>
	(() => {
		if (window.parent === window) return;

		let active = false;
		let picking = false;
		let overlay = null;
		let overlayTag = null;
		let current = null;
		/** path+label → seçilmiş element (kaldırma için). */
		const picked = new Map();
		let marker = null;
		let skeleton = null;

		const post = (message) => {
			try {
				window.parent.postMessage(message, "*");
			} catch {
				// üst pencere erişilemez
			}
		};

		const labelOf = (element) => {
			let name = element.tagName.toLowerCase();
			if (element.id) name += `#${element.id}`;
			else if (typeof element.className === "string" && element.className.trim()) {
				const first = element.className.trim().split(/\s+/)[0];
				if (first && !first.startsWith("reeyai-")) name += `.${first}`;
			}
			return name.length > 34 ? `${name.slice(0, 34)}…` : name;
		};

		const cssPath = (element) => {
			const parts = [];
			let node = element;
			let guard = 0;
			while (node && node.nodeType === 1 && guard < 5) {
				if (node === document.body || node === document.documentElement) break;
				let part = node.tagName.toLowerCase();
				if (node.id) {
					parts.unshift(`#${node.id}`);
					break;
				}
				const parent = node.parentElement;
				if (parent) {
					const siblings = Array.from(parent.children).filter((child) => child.tagName === node.tagName);
					if (siblings.length > 1) part += `:nth-of-type(${siblings.indexOf(node) + 1})`;
				}
				parts.unshift(part);
				node = parent;
				guard += 1;
			}
			return parts.join(" > ");
		};

		const contentOf = (element) => {
			const host = element.closest("[data-reeyai-content]");
			if (host) {
				try {
					const parsed = JSON.parse(host.getAttribute("data-reeyai-content") || "{}");
					if (parsed && typeof parsed === "object") return parsed;
				} catch {
					// geçersiz JSON — aşağıdaki özniteliklere düş
				}
			}
			const collection = element.closest("[data-reeyai-collection]");
			if (!collection) return null;
			return {
				collection: collection.getAttribute("data-reeyai-collection") || undefined,
				slug: collection.getAttribute("data-reeyai-slug") || undefined,
				field: element.closest("[data-reeyai-field]")?.getAttribute("data-reeyai-field") || undefined,
			};
		};

		const describe = (element) => {
			const text = (element.textContent || "").replace(/\s+/g, " ").trim().slice(0, 300);
			const html = element.outerHTML
				.replace(/\s+/g, " ")
				.replace(/\s*reeyai-picked\s*/g, " ")
				.replace(/ class="\s+/g, ' class="')
				.slice(0, 700);
			return {
				tag: element.tagName.toLowerCase(),
				label: labelOf(element),
				text,
				html,
				path: cssPath(element),
				content: contentOf(element),
			};
		};

		const ensureOverlay = () => {
			if (overlay) return;
			const style = document.createElement("style");
			style.textContent =
				"html.reeyai-picking,html.reeyai-picking *{cursor:crosshair !important}" +
				"[data-reeyai-picked]{outline:2px solid #dd641e !important;outline-offset:2px}" +
				"@keyframes reeyai-shimmer{0%{background-position:-480px 0}100%{background-position:480px 0}}" +
				"@keyframes reeyai-spin{to{transform:rotate(360deg)}}" +
				".reeyai-insert-marker{position:relative;height:0;border-top:3px solid #dd641e;margin:5px 0;pointer-events:none;z-index:2147483000}" +
				".reeyai-insert-marker>span{position:absolute;right:0;top:-11px;background:#dd641e;color:#fff;font:800 9px/1.5 ui-sans-serif,system-ui;letter-spacing:.08em;text-transform:uppercase;padding:1px 6px;white-space:nowrap}" +
				".reeyai-insert-skeleton{position:relative;box-sizing:border-box;width:100%;min-height:190px;margin:10px 0;border:1px dashed rgba(221,100,30,.55);background:linear-gradient(90deg,#f6f6f6 25%,#ececec 37%,#f6f6f6 63%);background-size:480px 100%;animation:reeyai-shimmer 1.3s linear infinite;display:flex;align-items:center;justify-content:center;z-index:1;pointer-events:none}" +
				".reeyai-insert-skeleton__inner{display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px;text-align:center}" +
				".reeyai-insert-skeleton__spinner{display:inline-block;width:30px;height:30px;border:2px solid #dd641e;border-top-color:transparent;border-radius:999px;animation:reeyai-spin .8s linear infinite}" +
				".reeyai-insert-skeleton__title{font:800 11px/1.4 ui-sans-serif,system-ui;letter-spacing:.12em;text-transform:uppercase;color:#dd641e}" +
				".reeyai-insert-skeleton__hint{font:500 10px/1.5 ui-sans-serif,system-ui;color:#737373}";
			document.head.appendChild(style);
			overlay = document.createElement("div");
			overlay.style.cssText =
				"position:fixed;z-index:2147483000;pointer-events:none;border:2px solid #4f8cff;" +
				"border-radius:6px;box-sizing:border-box;display:none;background:rgba(79,140,255,.06)";
			overlayTag = document.createElement("span");
			overlayTag.style.cssText =
				"position:absolute;top:-20px;left:-2px;background:#4f8cff;color:#fff;" +
				"font:500 10.5px/1.6 ui-sans-serif,system-ui;padding:1px 6px;border-radius:4px 4px 0 0;" +
				"white-space:nowrap;max-width:260px;overflow:hidden";
			overlay.appendChild(overlayTag);
			document.documentElement.appendChild(overlay);
		};

		const targetFor = (path, label) => {
			const selected = picked.get(`${path}|${label}`);
			if (selected && selected.isConnected) return selected;
			try {
				return document.querySelector(path);
			} catch {
				return null;
			}
		};

		const clearMarker = () => {
			if (marker) marker.remove();
			marker = null;
		};

		const clearSkeleton = () => {
			if (skeleton) skeleton.remove();
			skeleton = null;
		};

		const clearInsertion = () => {
			clearMarker();
			clearSkeleton();
		};

		const placeMarker = (path, label, position, scroll) => {
			clearMarker();
			const target = targetFor(path, label);
			if (!target || !target.parentElement) return;
			marker = document.createElement("div");
			marker.className = "reeyai-insert-marker";
			marker.setAttribute("data-reeyai-place", "");
			const tag = document.createElement("span");
			tag.textContent = position === "before" ? "Buradan önce" : "Buradan sonra";
			marker.appendChild(tag);
			if (position === "before") target.before(marker);
			else target.after(marker);
			if (scroll) target.scrollIntoView({ behavior: "smooth", block: "center" });
		};

		const placeSkeleton = (path, label, position) => {
			clearInsertion();
			const target = targetFor(path, label);
			skeleton = document.createElement("div");
			skeleton.className = "reeyai-insert-skeleton";
			skeleton.setAttribute("data-reeyai-skeleton", "");
			skeleton.setAttribute("role", "status");
			skeleton.setAttribute("aria-label", "AI yeni bölüm hazırlıyor");
			const inner = document.createElement("div");
			inner.className = "reeyai-insert-skeleton__inner";
			const spinner = document.createElement("span");
			spinner.className = "reeyai-insert-skeleton__spinner";
			const title = document.createElement("span");
			title.className = "reeyai-insert-skeleton__title";
			title.textContent = "Yeni bölüm hazırlanıyor";
			const hint = document.createElement("span");
			hint.className = "reeyai-insert-skeleton__hint";
			hint.textContent = "Değişiklik tamamlanınca burada görünecek.";
			inner.append(spinner, title, hint);
			skeleton.appendChild(inner);
			if (!target) {
				(document.querySelector("main") ?? document.body).appendChild(skeleton);
				skeleton.scrollIntoView({ behavior: "smooth", block: "center" });
				return;
			}
			if (position === "before") target.before(skeleton);
			else target.after(skeleton);
			target.scrollIntoView({ behavior: "smooth", block: "center" });
		};

		const onMove = (event) => {
			if (!picking || !overlay) return;
			const target = event.target;
			if (!(target instanceof Element) || target === overlay || target === document.documentElement) {
				overlay.style.display = "none";
				return;
			}
			const rect = target.getBoundingClientRect();
			overlay.style.display = "block";
			overlay.style.left = `${rect.left}px`;
			overlay.style.top = `${rect.top}px`;
			overlay.style.width = `${rect.width}px`;
			overlay.style.height = `${rect.height}px`;
			overlayTag.textContent = labelOf(target);
			current = target;
		};

		const onClick = (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			if (picking) {
				event.preventDefault();
				event.stopPropagation();
				if (overlay) overlay.style.display = "none";
				clearMarker();
				const selection = describe(target);
				const key = `${selection.path}|${selection.label}`;
				const existing = picked.get(key);
				const additive = Boolean(event.metaKey || event.ctrlKey || event.shiftKey);
				// Yeni seçim varsayılan olarak ÖNCEKİNİ DEĞİŞTİRİR. Çoklu seçim
				// yalnızca ⌘/Ctrl/Shift basılıyken eklenir (turan-widget paritesi).
				if (!additive) {
					for (const [oldKey, oldElement] of picked) {
						if (oldKey !== key) {
							if (oldElement.isConnected) oldElement.removeAttribute("data-reeyai-picked");
							picked.delete(oldKey);
						}
					}
				}
				if (existing && existing.isConnected) existing.removeAttribute("data-reeyai-picked");
				target.setAttribute("data-reeyai-picked", "");
				picked.set(key, target);
				post({ type: "reeyai:pick", selection, additive });
				return;
			}

			const anchor = target.closest("a[href]");
			if (!anchor || anchor.target === "_blank") return;
			const href = anchor.getAttribute("href");
			if (!href || href.startsWith("#") || /^(mailto:|tel:|javascript:)/i.test(href)) return;
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			event.stopPropagation();
			try {
				post({ type: "reeyai:navigate", href: new URL(href, location.href).toString() });
			} catch {
				// geçersiz URL
			}
		};

		const onMessage = (event) => {
			if (event.source !== window.parent) return;
			const data = event.data;
			if (!data || typeof data.type !== "string") return;

			if (data.type === "reeyai:hello") {
				ensureOverlay();
				if (!active) {
					document.addEventListener("mousemove", onMove, true);
					document.addEventListener("click", onClick, true);
					active = true;
				}
				post({ type: "reeyai:ready" });
				post({ type: "reeyai:page", path: location.pathname, title: document.title });
				return;
			}
			if (data.type === "reeyai:pick-mode") {
				picking = Boolean(data.on);
				document.documentElement.classList.toggle("reeyai-picking", picking);
				if (!picking && overlay) overlay.style.display = "none";
				return;
			}
			if (data.type === "reeyai:unpick") {
				const key = `${data.path}|${data.label}`;
				const element = picked.get(key);
				if (element) element.removeAttribute("data-reeyai-picked");
				picked.delete(key);
				return;
			}
			if (data.type === "reeyai:place") {
				if (typeof data.path === "string") {
					placeMarker(
						data.path,
						typeof data.label === "string" ? data.label : "",
						data.position === "before" ? "before" : "after",
						Boolean(data.scroll),
					);
				}
				return;
			}
			if (data.type === "reeyai:skeleton") {
				if (typeof data.path === "string") {
					placeSkeleton(
						data.path,
						typeof data.label === "string" ? data.label : "",
						data.position === "before" ? "before" : "after",
					);
				}
				return;
			}
			if (data.type === "reeyai:skeleton-clear") {
				clearInsertion();
				return;
			}
			if (data.type === "reeyai:reload") {
				location.reload();
				return;
			}
			if (data.type === "reeyai:back") {
				history.back();
				return;
			}
			if (data.type === "reeyai:forward") {
				history.forward();
			}
		};

		window.addEventListener("message", onMessage);
	})();
</script>
