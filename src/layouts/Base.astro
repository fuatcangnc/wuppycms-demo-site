---
import "../styles/global.css";
import ReeyaiBridge from "../components/ReeyaiBridge.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title = "Demo", description = "Demo sitesi" } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<header class="border-b border-border">
			<nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
				<a href="/" class="font-semibold tracking-tight">Demo</a>
				<span class="text-xs text-muted-foreground">İçerik GitHub'da yaşar</span>
			</nav>
		</header>
		<main class="mx-auto max-w-3xl px-4 py-section">
			<slot />
		</main>
		<footer class="mx-auto max-w-3xl border-t border-border px-4 py-8 text-xs text-muted-foreground">
			Fuat şablonu.
		</footer>
		<ReeyaiBridge />
	</body>
</html>
